{
  "name": "@mertcreates/eslint-plugin-next-pages-router",
  "version": "1.2.1",
  "description": "ESLint rules for validating Next.js Pages Router route comparisons and navigation targets against your pages directory.",
  "author": "Mert Ercan <me@mertercan.com> (https://mertercan.com)",
  "type": "commonjs",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.js",
      "import": "./index.js",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "rules/",
    "lib/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "eslint",
    "eslint-plugin",
    "next",
    "nextjs",
    "next-pages",
    "next-pages-router",
    "pages-router",
    "router",
    "routing",
    "pages"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mertcreates/eslint-plugin-next-pages-router.git"
  },
  "bugs": {
    "url": "https://github.com/mertcreates/eslint-plugin-next-pages-router/issues"
  },
  "homepage": "https://github.com/mertcreates/eslint-plugin-next-pages-router#readme",
  "sideEffects": false,
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/mertcreates"
  },
  "engines": {
    "node": ">=16"
  },
  "peerDependencies": {
    "eslint": "^8.0.0 || ^9.0.0",
    "next": ">=10"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "dependencies": {
    "@types/eslint": "8.56.12"
  },
  "devDependencies": {
    "c8": "^9.1.0",
    "eslint": "^9.0.0",
    "mocha": "^10.0.0",
    "typescript": "5.8.3"
  },
  "scripts": {
    "test": "mocha \"tests/rules/**/*.test.js\"",
    "test:coverage": "c8 --reporter=text --reporter=html mocha \"tests/rules/**/*.test.js\"",
    "bench": "node scripts/benchmark.js",
    "test:types": "node tests/types/package.test.cjs"
  }
}
